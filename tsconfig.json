{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/presentation/components/*"],
      "@layouts/*": ["./src/presentation/layouts/*"],
      "@assets/*": ["./src/presentation/assets/*"],
      "@styles/*": ["./src/presentation/styles/*"],
      "@features/*": ["./src/application/features/*"],
      "@hooks/*": ["./src/application/hooks/*"],
      "@store/*": ["./src/application/store/*"],
      "@context/*": ["./src/application/context/*"],
      "@services/*": ["./src/infrastructure/services/*"],
      "@api/*": ["./src/infrastructure/api/*"],
      "@middleware/*": ["./src/infrastructure/middleware/*"],
      "@lib/*": ["./src/infrastructure/lib/*"],
      "@types/*": ["./src/shared/types/*"],
      "@utils/*": ["./src/shared/utils/*"],
      "@constants/*": ["./src/shared/constants/*"],
      "@config/*": ["./src/shared/config/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
